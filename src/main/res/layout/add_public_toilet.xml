<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <android.support.v7.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/black"
        android:minHeight="?attr/actionBarSize" />


    <!--<ScrollView
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:layout_marginTop="16dp"
            android:orientation="vertical">-->

            <RelativeLayout
                android:id="@+id/relativelayoutadd"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/toolbar"
                android:layout_above="@+id/rippleViewAddToilet"
                android:layout_gravity="center">

                <ScrollView
                    android:id="@+id/scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:elevation="8dp"
                    android:layout_margin="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:weightSum="4">
                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="20dp"
                        android:weightSum="2">
                           <!-- <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:text="Name of the public toilet"
                                android:textColor="@android:color/darker_gray"
                                android:textSize="@dimen/text_size_default"/>
-->
                        <android.support.design.widget.TextInputLayout
                            android:id="@+id/titleTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColorHint="@color/black"
                            app:theme="@style/EditTextTheme">

                        <EditText
                            android:id="@+id/et_name_toilet"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords|textCapSentences"
                            android:hint="Name of the public toilet"
                            android:ems="10"
                            android:imeOptions="actionNext"
                            android:includeFontPadding="true"

                            android:maxLength="25"
                            android:maxLines="1"
                            android:paddingBottom="8dp"
                            android:paddingTop="18dp"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_default">


                        </EditText>
                        </android.support.design.widget.TextInputLayout>

                    </LinearLayout>


                        <LinearLayout
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="20dp"
                            android:weightSum="2">
                           <!-- <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:text="Ward Number"
                                android:textColor="@android:color/darker_gray"
                                android:textSize="@dimen/text_size_default"/>-->

                            <android.support.design.widget.TextInputLayout
                                android:id="@+id/titleTextInputLayout2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColorHint="@color/black"
                                app:theme="@style/EditTextTheme">
                            <EditText
                                android:id="@+id/et_ward_number"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:hint="Ward Number"
                                android:ems="10"
                                android:imeOptions="actionNext"
                                android:includeFontPadding="true"
                                android:inputType="number"
                                android:maxLength="30"
                                android:maxLines="1"
                                android:paddingBottom="8dp"
                                android:paddingTop="18dp"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_size_default">


                            </EditText>
                            </android.support.design.widget.TextInputLayout>

                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="20dp"
                            android:weightSum="2">
                          <!--  <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:text="Toilet Address"
                                android:textColor="@android:color/darker_gray"
                                android:textSize="@dimen/text_size_default"/>-->

                            <android.support.design.widget.TextInputLayout
                                android:id="@+id/titleTextInputLayout3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColorHint="@color/black"
                                app:theme="@style/EditTextTheme">
                            <EditText
                                android:id="@+id/et_toilet_address"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords|textCapSentences|textImeMultiLine"
                                android:hint="Toilet Address"
                                android:ems="1"
                                android:imeOptions="actionNext"
                                android:includeFontPadding="true"

                                android:maxLength="200"
                                android:maxLines="3"
                                android:paddingBottom="8dp"
                                android:paddingTop="18dp"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_size_default">


                            </EditText>
                            </android.support.design.widget.TextInputLayout>
                            <LinearLayout
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="20dp"
                                android:weightSum="2">
                                <!--<TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:text="Pincode"
                                    android:textColor="@android:color/darker_gray"
                                    android:textSize="@dimen/text_size_default"/>-->
                                <android.support.design.widget.TextInputLayout
                                    android:id="@+id/titleTextInputLayout4"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColorHint="@color/black"
                                    app:theme="@style/EditTextTheme">
                                <EditText
                                    android:id="@+id/et_pincode"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Pincode"
                                    android:ems="10"
                                    android:imeOptions="actionNext"
                                    android:includeFontPadding="true"
                                    android:inputType="number"
                                    android:maxLength="6"
                                    android:maxLines="1"
                                    android:paddingBottom="8dp"
                                    android:paddingTop="18dp"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/text_size_default">


                                </EditText>
                                </android.support.design.widget.TextInputLayout>

                            </LinearLayout>


                        </LinearLayout>


                    </LinearLayout>
                </ScrollView>

</RelativeLayout>
    <com.andexert.library.RippleView
        android:id="@+id/rippleViewAddToilet"
        rv_centered="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
                >
    <Button
        android:id="@+id/next_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:background="@drawable/signup_with_fb_bg"
        android:text="@string/get_started" />
    </com.andexert.library.RippleView>
</RelativeLayout>