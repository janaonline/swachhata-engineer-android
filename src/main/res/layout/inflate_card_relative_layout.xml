<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/rl_top_cc"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/notif_item_click"
	android:gravity="center"
	android:orientation="vertical" >

	<RelativeLayout
		android:id="@+id/rl_cc_top"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:layout_margin="8dp"
		android:orientation="horizontal" >

		<android.support.design.widget.FloatingActionButton
			android:id="@+id/user_image"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_alignParentTop="true"
			android:layout_centerVertical="true"
			android:background="@drawable/round_image_bg"
			android:drawingCacheQuality="high"
			app:fabSize="normal" />

		<TextView
			android:id="@+id/tv_username"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentRight="true"
			android:layout_centerInParent="true"
			android:layout_marginLeft="10dip"
			android:layout_toRightOf="@+id/user_image"
			android:maxLines="3"
			android:text="Patriatic User has voted up on your complaint - Defacement Of Buildings And Public Property-Vasanth Nagar,Bengaluru"
			android:textColor="@color/black"
			android:textSize="14sp" />
	</RelativeLayout>

	<View
		android:id="@+id/view"
		android:layout_width="match_parent"
		android:layout_height="1px"
		android:layout_below="@+id/rl_cc_top"
		android:background="#e6e6e6" />

</RelativeLayout>