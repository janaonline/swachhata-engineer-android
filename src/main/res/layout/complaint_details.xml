<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                 xmlns:app="http://schemas.android.com/apk/res-auto"
                                                 xmlns:tools="http://schemas.android.com/tools"
                                                 android:id="@+id/rootLayout"
                                                 android:layout_width="match_parent"
                                                 android:layout_height="match_parent"
                                                 tools:context=".ComplaintDetail">

    <android.support.design.widget.AppBarLayout
        android:id="@+id/appbarlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:expanded="true">

        <android.support.design.widget.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
           app:expandedTitleMargin="48dp"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            app:collapsedTitleTextAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
            app:contentScrim="@color/black"
            app:expandedTitleTextAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:title="">

            <FrameLayout
                android:id="@+id/framePictures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fitsSystemWindows="true"
                app:layout_collapseMode="parallax">

                <com.android.volley.toolbox.NetworkImageView
                    android:id="@+id/complaint_image"
                    android:layout_width="match_parent"
                    android:layout_height="256dp"
                    android:minHeight="256dp"
                    android:scaleType="centerCrop"/>

                <TextView
                    android:id="@+id/complaint_landmark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#A1000000"
                    android:drawableLeft="@mipmap/ic_location_city_white_24dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:maxLines="3"
                    android:paddingBottom="8dp"
                    android:paddingLeft="16dp"
                    android:paddingTop="8dp"
                    android:text="@string/loading"
                    android:textColor="@color/white"
                    android:textSize="14sp"/>
            </FrameLayout>

            <android.support.v7.widget.Toolbar
                android:id="@+id/maintoolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:focusableInTouchMode="true"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>
        </android.support.design.widget.CollapsingToolbarLayout>
    </android.support.design.widget.AppBarLayout>

    <android.support.v7.widget.Toolbar
        android:id="@+id/maintoolbar1"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        app:layout_collapseMode="pin"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>

    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/maintoolbar1"
        android:focusableInTouchMode="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">


            <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                            xmlns:app="http://schemas.android.com/apk/res-auto"
                            android:id="@+id/parentLayout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/white"
                            android:fitsSystemWindows="true">

                <android.support.design.widget.AppBarLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:theme="@style/AppTheme.AppBarOverlay">

                    <!--  <ScrollView
                          android:id="@+id/scrollView1"
                          android:layout_width="fill_parent"
                          android:layout_height="wrap_content"
                          android:layout_alignParentBottom="true"
                          android:layout_alignParentLeft="true"
                          android:layout_alignParentStart="true"

                          android:scrollbars="none">-->

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:orientation="vertical">


                        <RelativeLayout
                            android:id="@+id/rl_top"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:background="@color/white"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/view"
                                android:layout_width="match_parent"
                                android:layout_height="1px"
                                android:background="#e6e6e6"/>

                            <TextView
                                android:id="@+id/votedUpCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:gravity="center_vertical"
                                android:text=""
                                android:textColor="#757575"
                                android:textSize="12sp"
                                android:visibility="gone"/>

                            <RelativeLayout
                                android:id="@+id/rl_top_cc"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/view"
                                android:layout_centerVertical="true"

                                android:background="@color/white"
                                android:gravity="center"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:id="@+id/rl_cc_top"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:background="#f5f6f8">

                                    <RelativeLayout
                                        android:id="@+id/rl_cc_top2"
                                        android:layout_width="fill_parent"
                                        android:layout_height="72dp" >


                                        <RelativeLayout
                                            android:id="@+id/rl_cc_top1"
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginLeft="16dp"
                                            android:layout_marginRight="16dp"
                                            android:layout_marginTop="16dp"
                                            android:orientation="horizontal">

                                            <de.hdodenhof.circleimageview.CircleImageView
                                                android:id="@+id/user_image"
                                                android:layout_width="48dp"
                                                android:layout_height="48dp"
                                                android:layout_alignParentTop="true"
                                                android:layout_centerVertical="true"
                                                app:civ_border_color="@color/gray_closed"
                                                app:civ_border_width="0.2dp"/>

                                            <TextView
                                                android:id="@+id/tv_username"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_marginLeft="10dip"
                                                android:layout_toLeftOf="@+id/complaint_status"
                                                android:layout_toRightOf="@+id/user_image"
                                                android:maxLines="1"
                                                android:text="Paul Walker"
                                                android:textColor="@color/black"
                                                android:textSize="14sp"
                                                android:textStyle="bold"/>


                                            <TextView
                                                android:id="@+id/complaint_status"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_centerVertical="true"
                                                android:layout_gravity="top|right"
                                                android:layout_marginBottom="8dp"
                                                android:layout_marginLeft="8dp"
                                                android:layout_marginTop="8dp"
                                                android:layout_toLeftOf="@+id/change_status"
                                                android:background="@drawable/complaint_status_on_the_job"
                                                android:text="ON-THE-JOB"
                                                android:textAllCaps="true"
                                                android:textColor="@color/blue_on_the_job"
                                                android:textSize="12sp"/>

                                            <ImageView
                                                android:id="@+id/change_status"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_alignParentRight="true"
                                                android:layout_centerVertical="true"
                                                android:layout_gravity="top|right"
                                                android:layout_marginRight="8dp"
                                                android:scaleType="fitCenter"
                                                android:src="@mipmap/ic_arrow_drop_down_black_24dp"
                                                android:text="ON-THE-JOB"
                                                android:textAllCaps="true"
                                                android:textColor="@color/blue_on_the_job"
                                                android:textSize="12sp"/>

                                            <RelativeLayout
                                                android:id="@+id/user_down"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_alignLeft="@+id/tv_username"
                                                android:layout_alignRight="@+id/tv_username"
                                                android:layout_below="@+id/tv_username"
                                                android:layout_toLeftOf="@+id/complaint_status"
                                                android:scaleType="fitCenter">

                                                <TextView
                                                    android:id="@+id/hours_ago"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_alignParentLeft="true"
                                                    android:layout_alignParentRight="true"
                                                    android:maxLines="1"
                                                    android:text="2 hours ago"
                                                    android:textColor="#757575"
                                                    android:textSize="12dp"/>
                                            </RelativeLayout>
                                        </RelativeLayout>
                                    </RelativeLayout>
                                </LinearLayout>

                                <RelativeLayout
                                    android:id="@+id/rl_cc_bottom"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/rl_cc_top">

                                    <RelativeLayout
                                        android:id="@+id/rl_cc_bottom1"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content">

                                        <RelativeLayout
                                            android:id="@+id/shadow"
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:elevation="2dp">

                                            <LinearLayout
                                                android:id="@+id/category_layout"
                                                android:layout_width="fill_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_marginLeft="16dp"
                                                android:layout_marginRight="16dp"
                                                android:layout_marginTop="16dp"
                                                android:orientation="vertical">


                                                <TextView
                                                    android:id="@+id/complaint_category"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="bottom"
                                                    android:layout_marginBottom="2dp"
                                                    android:layout_marginLeft="8dp"
                                                    android:gravity="center_vertical"
                                                    android:text="Bad Roads"
                                                    android:textColor="@color/black"
                                                    android:textSize="14sp"
                                                    android:textStyle="bold"/>

                                                <TextView
                                                    android:id="@+id/complaintLocation"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="bottom"
                                                    android:layout_marginBottom="2dp"
                                                    android:layout_marginLeft="8dp"
                                                    android:layout_marginTop="8dp"
                                                    android:gravity="center_vertical"
                                                    android:text="The devider in between the Hosur road is broken and is a major problem to the motorists.Stones and mud from the broken divider."
                                                    android:textColor="@color/secondary_text_color"
                                                    android:textSize="14sp"/>
                                            </LinearLayout>


                                            <LinearLayout
                                                android:id="@+id/resolve_notresolve"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"

                                                android:layout_below="@+id/category_layout"

                                                android:orientation="vertical">

                                                <LinearLayout
                                                    android:id="@+id/not_resolved0"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_below="@+id/view1"
                                                    android:layout_marginBottom="16dp"
                                                    android:layout_marginTop="8dp"
                                                    android:orientation="horizontal"
                                                    android:visibility="gone">

                                                    <TextView
                                                        android:id="@+id/voteup"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"

                                                        android:maxLines="1"
                                                        android:text="34 Votes"
                                                        android:textColor="#757575"
                                                        android:textSize="14sp"/>

                                                    <de.hdodenhof.circleimageview.CircleImageView
                                                        android:layout_width="8dp"
                                                        android:layout_height="8dp"
                                                        android:layout_gravity="center"
                                                        android:layout_marginLeft="8dp"
                                                        android:layout_marginRight="8dp"
                                                        android:src="@color/secondary_text_color"/>

                                                    <TextView
                                                        android:id="@+id/comments"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:layout_gravity="center"
                                                        android:gravity="left"
                                                        android:maxLines="1"
                                                        android:text="7 Comments"
                                                        android:textColor="#757575"
                                                        android:textSize="14sp"
                                                        android:textStyle=""/>


                                                </LinearLayout>

                                                <include
                                                    layout="@layout/inflate_voteup_feedback"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"/>
                                            </LinearLayout>
                                        </RelativeLayout>

                                        <View
                                            android:id="@+id/viewLine"
                                            android:layout_width="match_parent"
                                            android:layout_height="0.5dp"
                                            android:layout_below="@+id/shadow"
                                            android:background="@color/complaint_id_bgcolor"/>

                                        <View
                                            android:id="@+id/view11"
                                            android:layout_width="match_parent"
                                            android:layout_height="1dp"
                                            android:layout_below="@+id/viewLine"
                                            android:background="#e6e6e6"/>


                                        <android.support.design.widget.TabLayout
                                            android:id="@+id/tabs"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_below="@+id/view11"
                                            android:background="@color/white"
                                            app:tabGravity="fill"
                                            app:tabIndicatorColor="@color/blue_on_the_job"
                                            app:tabMode="fixed"
                                            app:tabSelectedTextColor="@color/black"
                                            app:tabTextColor="@color/secondary_text_color"/>

                                        <View
                                            android:id="@+id/view12"
                                            android:layout_width="match_parent"
                                            android:layout_height="1dp"
                                            android:layout_below="@+id/tabs"
                                            android:background="#e6e6e6"/>

                                        <com.ichangemycity.customui.WrapContentViewPager
                                            android:id="@+id/viewpager"
                                            android:layout_width="fill_parent"
                                            android:layout_height="match_parent"
                                            android:layout_below="@+id/view12"/>
                                    </RelativeLayout>

                                    <TextView
                                        android:id="@+id/hours"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="7dp"
                                        android:text=""
                                        android:visibility="gone"/>
                                </RelativeLayout>
                            </RelativeLayout>
                        </RelativeLayout>
                    </LinearLayout>
                    <!-- </ScrollView>-->
                </android.support.design.widget.AppBarLayout>

            </RelativeLayout>

        </LinearLayout>

    </android.support.v4.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/frameLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:visibility="gone">

        <TextView
            android:id="@+id/loadingString"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/loading"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:indeterminate="true"/>
    </FrameLayout>


</android.support.design.widget.CoordinatorLayout>
