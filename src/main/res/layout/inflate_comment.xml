<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content">

  <RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="16dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <de.hdodenhof.circleimageview.CircleImageView
      android:id="@+id/userImage"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:src="@mipmap/ic_launcher"
      app:civ_border_color="@color/gray_closed"
      app:civ_border_width="0.2dp" />

    <TextView
      android:id="@+id/userName"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginLeft="8dp"
      android:layout_toEndOf="@+id/userImage"
      android:layout_toRightOf="@+id/userImage"
      android:text="ICMyC Engineer ICMyC Engineer ICMyC Engineer "
      android:textColor="@color/black"
      android:textSize="14dp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/postedOn"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_below="@+id/userName"
      android:layout_alignParentRight="true"
      android:layout_alignLeft="@+id/userName"
      android:text="2hours ago"
      android:textColor="@color/lt_gray"
      android:textSize="14sp"  />
    <HorizontalScrollView
      android:id="@+id/imageLayout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_below="@+id/postedOn"
      android:layout_alignLeft="@+id/userName"
      android:layout_marginTop="8dp"
      android:scrollbars="none">

      <LinearLayout
        android:id="@+id/imageLinear"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="left"
        android:layout_marginBottom="8dp"
        android:background="@color/transparent"
        android:gravity="left"
        android:orientation="horizontal"></LinearLayout>
    </HorizontalScrollView>
    <TextView
      android:id="@+id/description_count"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_below="@+id/imageLayout"
      android:layout_alignLeft="@+id/userName"
      android:layout_marginTop="4dp"
      android:gravity="left"
      android:text="@string/mr_button_content_description"
      android:textColor="@color/secondary_text_color"
      android:textSize="14sp"
      android:visibility="visible" />


  </RelativeLayout>


</RelativeLayout>