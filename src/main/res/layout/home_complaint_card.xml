<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:card_view="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:id="@+id/card"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:layout_marginTop="16dip"
              android:orientation="vertical" >

    <android.support.v7.widget.CardView
        android:id="@+id/cv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stateListAnimator="@anim/lift_on_touch"
        app:cardCornerRadius="0dp"
        card_view:cardElevation="0dp"
        card_view:cardPreventCornerOverlap="false"
        card_view:cardUseCompatPadding="true" >

        <RelativeLayout
            android:id="@+id/rl_top"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:descendantFocusability="blocksDescendants"
            android:gravity="center"
            android:orientation="vertical" >

            <RelativeLayout
                android:id="@+id/rl_top_feed"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="0dp"
                android:background="#f5f6f8"
                android:orientation="vertical"
                android:paddingBottom="5dp" >

                <ImageView
                    android:id="@+id/feed_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="16dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:src="@mipmap/ic_flag_white_24dp"
                    android:textColor="#0a80f4"
                    android:textSize="14dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_feed_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="16dp"
                    android:layout_toRightOf="@+id/feed_flag"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text="Jagadeesh"
                    android:textColor="#0a80f4"
                    android:textSize="14dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_feed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="2dp"
                    android:layout_toRightOf="@+id/tv_feed_user_name"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="posted a complaint"
                    android:textColor="@color/black"
                    android:textSize="14dp" />
            </RelativeLayout>

            <View
                android:id="@+id/view0"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_below="@+id/rl_top_feed"
                android:background="#e6e6e6" />

            <RelativeLayout
                android:id="@+id/rl_top_cc"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_top_feed"
                android:layout_centerVertical="true"
                android:background="@color/white"
                android:gravity="center"
                android:orientation="vertical" >

                <RelativeLayout
                    android:id="@+id/rl_cc_top"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:orientation="horizontal" >

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/user_image"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_alignParentTop="true"
                        android:layout_centerVertical="true"
                        android:adjustViewBounds="true"
                        android:background="@drawable/round_image_bg"
                        android:scaleType="centerCrop"  />

                    <TextView
                        android:id="@+id/tv_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_marginLeft="10dip"
                        android:layout_toLeftOf="@+id/complaint_status"
                        android:layout_toRightOf="@+id/user_image"
                        android:singleLine="true"
                        android:text="Vishwas Madishetty"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/complaint_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_gravity="top|right"
                        android:layout_margin="8dp"
                        android:background="@drawable/complaint_status_closed"
                        android:text="CLOSED"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <RelativeLayout
                        android:id="@+id/user_down"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignLeft="@+id/tv_username"
                        android:layout_below="@+id/tv_username"
                        android:layout_toLeftOf="@+id/complaint_status"
                        android:scaleType="fitCenter" >

                        <TextView
                            android:id="@+id/created_on"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentRight="true"
                            android:maxLines="1"
                            android:text="2 hours ago"
                            android:textColor="#757575"
                            android:textSize="14dp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl_cc_middle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rl_cc_top" >

                    <RelativeLayout
                        android:id="@+id/rl_cc_images"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"

                        android:orientation="horizontal" >

                        <com.android.volley.toolbox.NetworkImageView
                            android:id="@+id/complaint_image"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_marginRight="8dp"
                            android:background="@color/transparent"
                            android:scaleType="fitXY"
                            android:src="@mipmap/comp_image" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rl_cc_bottom"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:layout_marginLeft="18dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_toLeftOf="@+id/rl_cc_images" >

                        <TextView
                            android:id="@+id/complaint_category"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:gravity="center_vertical"
                            android:text="Garbage Dump "
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/complaint_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignLeft="@+id/complaint_category"
                            android:layout_alignRight="@+id/complaint_category"
                            android:layout_below="@+id/complaint_category"
                            android:layout_gravity="bottom"
                            android:gravity="center_vertical"
                            android:text="Outer Ring Rd, Dollar scheme colony, Stage1, BTM Layout, Bengaluru"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:id="@+id/counts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/complaint_description"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal" >

                            <TextView
                                android:id="@+id/votedUpCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignLeft="@+id/complaint_category"
                                android:layout_alignRight="@+id/complaint_category"
                                android:layout_below="@+id/complaint_category"
                                android:layout_gravity="bottom"
                                android:gravity="center_vertical"
                                android:text="27 Voted up"
                                android:textColor="#757575"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/DOT"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_alignLeft="@+id/complaint_category"
                                android:layout_alignRight="@+id/complaint_category"
                                android:layout_gravity="center"
                                android:layout_marginLeft="6dp"
                                android:layout_marginRight="6dp"
                                android:background="@drawable/dot" />

                            <TextView
                                android:id="@+id/commentedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignLeft="@+id/complaint_category"
                                android:layout_alignRight="@+id/complaint_category"
                                android:layout_below="@+id/counts"
                                android:layout_gravity="bottom"
                                android:gravity="center_vertical"
                                android:text="9 Comment"
                                android:textColor="#757575"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <View
                        android:id="@+id/view"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_below="@+id/rl_cc_bottom"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp"
                        android:background="#e6e6e6" />

                    <RelativeLayout
                        android:id="@+id/not_resolved"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/view"
                        android:layout_marginLeft="8dp"
                        android:orientation="horizontal" >

                        <FrameLayout
                            android:id="@+id/frameSpinner"
                            android:layout_width="168dp"
                            android:layout_height="wrap_content" >

                            <TextView
                                android:id="@+id/dropdown"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center|right"
                                android:background="@mipmap/ic_arrow_drop_down_black_24dp" />

                            <Spinner
                                android:id="@+id/changeStatus"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_alignParentLeft="true"
                                android:popupBackground="@color/white" />
                        </FrameLayout>


                        <LinearLayout
                            android:id="@+id/resolved"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_alignParentLeft="true"
                            android:layout_toLeftOf="@+id/comment"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            android:weightSum="4" >

                            <TextView
                                android:id="@+id/satisfaction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_weight="1"
                                android:drawableLeft="@mipmap/ic_feedback1"
                                android:gravity="center"
                                android:padding="4dp"
                                android:scaleType="fitCenter"
                                android:text="10"
                                android:textColor="#757575"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/neutral"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawableLeft="@mipmap/ic_feedback3"
                                android:gravity="center"
                                android:padding="4dp"
                                android:scaleType="fitCenter"
                                android:text="22"
                                android:textColor="#757575"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/un_satisfied"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawableLeft="@mipmap/ic_feedback4"
                                android:gravity="center"
                                android:padding="4dp"
                                android:scaleType="fitCenter"
                                android:text="5"
                                android:textColor="#757575"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/comment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_gravity="right"
                            android:layout_marginRight="8dp"
                            android:layout_toLeftOf="@+id/share"
                            android:drawableLeft="@mipmap/ic_message_white_24dp"
                            android:drawablePadding="4dp"
                            android:gravity="center"
                            android:padding="4dp"
                            android:singleLine="true"
                            android:textColor="#757575"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/share"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:layout_gravity="right"
                            android:layout_marginRight="8dp"
                            android:drawableLeft="@mipmap/ic_share_white_24dp"
                            android:drawablePadding="4dp"
                            android:gravity="center"
                            android:padding="4dp"
                            android:singleLine="true"
                            android:textColor="#757575"
                            android:textSize="14sp" />
                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>
        </RelativeLayout>
    </android.support.v7.widget.CardView>

</LinearLayout>